# ==========================================
# DisasterLink v2.0 Environment Configuration
# Copy this file to .env before running docker-compose up
# ==========================================

# Database
MYSQL_ROOT_PASSWORD= Your_mysql_password

# JWT Security (Minimum 32 characters)
JWT_SECRET=your_security_key

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Google Gemini AI API Key (Optional - leave blank to use intelligent rule-based triage)
GEMINI_API_KEY=Your_gemini_api_key

# ntfy.sh Mobile Push Notification Topic (Change to avoid overlap)
NTFY_TOPIC=your_ntfy_topic
